{
  "name": "dsh-infinite-gen-4",
  "version": "0.7.1",
  "description": "DeepSeek-V4.1 / V4 Flash 网络安全红队工具（无限四代）v0.7.1：双层协同注入内核 + 对话框热开关，按模型分流 7 份载荷（自持 dsh / 备用 dsh-gen4 / Codex 三档 / Claude / Grok），settings 命名空间落盘、profile 元数据工具、实时会话投影与客户端状态条。",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minglink/dsh-infinite-gen-4.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "HARNESS_PLUGIN.md",
    "README.md",
    "LICENSE",
    "prompts",
    "tests",
    "scripts",
    "assets"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js",
    "verify": "node scripts/verify_prompt_gen4.mjs",
    "verify:gen4": "node scripts/verify_prompt_gen4.mjs"
  },
  "dsh": {
    "id": "dsh-infinite-gen-4",
    "name": "无限四代",
    "version": "0.7.1",
    "repo": "Minglink/dsh-infinite-gen-4",
    "permissions": "系统提示词注入, 客户端状态条, 用户设置（dsh-infinite-gen-4 命名空间）",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
