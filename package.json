{
  "name": "dsh-switch-armor",
  "version": "0.10.0",
  "description": "Switch Armor — DeepSeek Harness 的系统提示词注入引擎：按会话实际模型在 7 份交付契约间自动分流，段位可控、会话级开关、实时状态投影。",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "system-prompt",
    "prompt-injection",
    "llm-routing"
  ],
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jipika/dsh-switch-armor.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "HARNESS_PLUGIN.md",
    "README.md",
    "LICENSE",
    "prompts",
    "tests",
    "scripts",
    "assets"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js",
    "verify": "node scripts/verify_prompt_gen4.mjs",
    "verify:gen4": "node scripts/verify_prompt_gen4.mjs"
  },
  "dsh": {
    "id": "dsh-switch-armor",
    "name": "Switch Armor",
    "version": "0.10.0",
    "repo": "jipika/dsh-switch-armor",
    "permissions": "系统提示词注入, 客户端状态条, 用户设置（dsh-switch-armor 命名空间）",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
